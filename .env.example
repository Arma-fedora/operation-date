# Browser configuration (Vite). Copy to `.env.local` and fill in.
#
# Leave VITE_SUPABASE_URL empty to run the app in demo mode:
# progress is stored only in localStorage and the final answer is not sent anywhere.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Set to `true` to force local-only mode even when Supabase is configured.
VITE_DEMO_MODE=
