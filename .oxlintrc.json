{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["public/vendor/**"],
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["useToast", "useTelegram", "useAudio", "useAudioOptional", "useSfx", "useRegisterBackHandler"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/providers/TelegramProvider.tsx",
        "src/app/providers/AudioProvider.tsx",
        "src/components/fx/Typewriter.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
