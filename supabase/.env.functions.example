# Supabase Edge Function secrets. Copy to `supabase/.env.functions` and fill in.
# Deploy with:
#   supabase secrets set --env-file supabase/.env.functions
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically for
# deployed functions. Uncomment them only for local `supabase functions serve`
# and use the values from `supabase status`.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=https://your-app.example.com
INITDATA_MAX_AGE_SECONDS=86400

# Optional: comma-separated Telegram user IDs allowed to open the app.
# Leave empty to let any user who finds the bot start the investigation.
TELEGRAM_ALLOWED_USER_IDS=
